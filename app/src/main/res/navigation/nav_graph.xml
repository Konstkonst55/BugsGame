<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navGraph"
    app:startDestination="@id/registerFragment">

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.kxnst.bugsgame.presentation.register.RegisterFragment"
        android:label="@string/register_title">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.kxnst.bugsgame.presentation.home.HomeFragment"
        android:label="@string/home_title" />

    <fragment
        android:id="@+id/gameFragment"
        android:name="com.kxnst.bugsgame.presentation.game.GameFragment"
        android:label="@string/game_title" />

    <fragment
        android:id="@+id/rulesFragment"
        android:name="com.kxnst.bugsgame.presentation.rules.RulesFragment"
        android:label="@string/rules_title" />

    <fragment
        android:id="@+id/authorsFragment"
        android:name="com.kxnst.bugsgame.presentation.authors.AuthorsFragment"
        android:label="@string/authors_title" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.kxnst.bugsgame.presentation.settings.SettingsFragment"
        android:label="@string/settings_title" />

    <action
        android:id="@+id/action_global_settings"
        app:destination="@id/settingsFragment" />

    <action
        android:id="@+id/action_global_rules"
        app:destination="@id/rulesFragment" />

</navigation>
